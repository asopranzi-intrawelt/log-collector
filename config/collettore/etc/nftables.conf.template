#!/usr/sbin/nft -f
# Firewall locale del collettore (handoff, sezione 2 punto 6). Generato da ads-render.py:
# non modificare sul collettore, si cambia il template nel repository.
#
# Ingresso: syslog in chiaro (514/udp) e TLS (6514/tcp) solo dalle reti delle sorgenti, SSH
# solo dalle postazioni degli amministratori non MSP (una o piu', ADR-007). Collaudo punto 2: da una sorgente non ammessa nessuna
# scrittura. Uscita libera verso NTP, iLO, TSA, relay SMTP, NAS-HERO e API.
# La seconda rete e' facoltativa: oggi la LAN e' unica e subnet_server resta vuoto.

flush ruleset

table inet filter {
  chain input {
    type filter hook input priority 0; policy drop;
    ct state established,related accept
    ct state invalid drop
    iif lo accept
    ip saddr { {{ rete.subnet_lan + rete.subnet_server }} } udp dport 514 accept
    ip saddr { {{ rete.subnet_lan + rete.subnet_server }} } tcp dport 6514 accept
    ip saddr { {{ rete.ip_admin_non_msp }} } tcp dport 22 accept
    icmp type echo-request accept
    # Neighbor discovery IPv6: senza, l'interfaccia perde i vicini se IPv6 e' attivo.
    icmpv6 type { nd-neighbor-solicit, nd-neighbor-advert, nd-router-advert } accept
  }
  chain forward {
    type filter hook forward priority 0; policy drop;
  }
  chain output {
    type filter hook output priority 0; policy accept;
  }
}
