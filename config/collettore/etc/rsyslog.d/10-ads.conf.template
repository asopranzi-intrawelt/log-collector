# Collettore AdS: ricezione dalle sorgenti e accessi al collettore stesso (studio, sezione 4;
# handoff, sezione 2 punto 7). Installato da ads-bootstrap.sh; si cambia nel repository.
#
# Ogni riga si scrive nel formato AdsLine: ora di ricezione, sorgente (IP di provenienza), ora
# dichiarata dalla sorgente, sistema dichiarato, messaggio. La cartella e' per IP di provenienza
# e non per hostname, perche' l'hostname nel messaggio lo sceglie il mittente. Il giorno del
# file e' quello locale del collettore (Europe/Rome).
#
# Sicurezza: TLS sulla 6514 con client anonimi, l'autenticazione del mittente e' l'indirizzo,
# filtrato da nftables; la 514/udp resta per gli apparati che non sanno fare TLS.

module(load="imudp")
module(load="imtcp" StreamDriver.Name="gtls" StreamDriver.Mode="1" StreamDriver.AuthMode="anon")

global(DefaultNetstreamDriverCAFile="/etc/rsyslog.d/tls/ca.pem"
       DefaultNetstreamDriverCertFile="/etc/rsyslog.d/tls/collector.pem"
       DefaultNetstreamDriverKeyFile="/etc/rsyslog.d/tls/collector.key")

template(name="AdsFile" type="string" string="/srv/ads/%fromhost-ip%/%$year%-%$month%-%$day%.log")
# Gli eventi iLO diversi dagli accessi espliciti vanno in un flusso separato. La destinazione
# comprende anche eventi non ancora classificati: va ispezionata prima dell'attivazione reale.
template(name="AdsIloOtherFile" type="string" string="/var/log/ads-ilo-other/%fromhost-ip%/%$year%-%$month%-%$day%.log")
# Il campo messaggio e' $!ads_msg, calcolato nel ruleset: tag e testo riattaccati esattamente come
# erano nella riga RFC 3164, e separati da uno spazio nei messaggi RFC 5424, dove sono due campi
# distinti. Una regola "spazio se manca" era sbagliata: con il firewall Zyxel, che non scrive un
# nome di programma, rsyslog prende 'src="<ip>:' per tag e lo spazio finiva dentro l'indirizzo
# (provato in container il 2026-10-02 con una riga del firewall). La prova non si altera.
template(name="AdsLine" type="string"
         string="%timegenerated:::date-rfc3339% %fromhost-ip% %timereported:::date-rfc3339% %hostname% %$!ads_msg:::drop-last-lf%\n")

# Zyxel ZLD scrive l'anno dopo l'ora ("Oct  2 05:35:37 2026 usgflex500 ..."): senza
# detect.YearAfterTimestamp il parser prende l'anno per il nome del sistema (osservato sul
# collettore il 2026-10-02). Il parser RFC 5424 resta il primo, per i mittenti che lo usano.
parser(name="ads.rfc3164anno" type="pmrfc3164" detect.YearAfterTimestamp="on")

ruleset(name="ads" parser=["rsyslog.rfc5424", "ads.rfc3164anno"]) {
    if $protocol-version == "1" then {
        set $!ads_msg = $syslogtag & " " & $msg;
    } else {
        set $!ads_msg = $syslogtag & $msg;
    }
    if {{ rsyslog_ip_match(sorgenti.ilo) }} then {
        # Corrispondenze osservate sul dispositivo: Browser login, failure, logout. Le forme
        # SSH e Remote console sono documentate da HPE ma non ancora provate su questa iLO.
        if $!ads_msg startswith "iLO5 Browser login:" or
           $!ads_msg startswith "iLO5 Browser login failure from:" or
           $!ads_msg startswith "iLO5 Browser logout:" or
           $!ads_msg startswith "iLO5 SSH login:" or
           $!ads_msg startswith "iLO5 SSH login failure from:" or
           $!ads_msg startswith "iLO5 SSH logout:" or
           $!ads_msg startswith "iLO5 Remote console login:" or
           $!ads_msg startswith "iLO5 Remote console login failure from:" then {
            action(type="omfile" dynaFile="AdsFile" template="AdsLine"
                   fileOwner="root" fileGroup="ads" fileCreateMode="0640"
                   dirOwner="root" dirGroup="ads" dirCreateMode="0750")
        } else {
            action(type="omfile" dynaFile="AdsIloOtherFile" template="AdsLine"
                   fileOwner="root" fileGroup="adm" fileCreateMode="0640"
                   dirOwner="root" dirGroup="adm" dirCreateMode="0750")
        }
    } else {
        action(type="omfile" dynaFile="AdsFile" template="AdsLine"
               fileOwner="root" fileGroup="ads" fileCreateMode="0640"
               dirOwner="root" dirGroup="ads" dirCreateMode="0750")
    }
}

input(type="imudp" port="514" ruleset="ads")
input(type="imtcp" port="6514" ruleset="ads")

# Accessi al collettore stesso: anche il login al collettore e' un accesso AdS. I messaggi locali
# di autenticazione vanno anche nel ruleset ads, cioe' in /srv/ads/127.0.0.1/, oltre che nei log
# di sistema. gdm-password copre il login grafico (ADR-012). Per SSH si prende ogni nome che
# comincia con "sshd": da OpenSSH 9.8 i login li scrive sshd-session, non sshd (osservato sul
# collettore il 2026-10-01 con OpenSSH 10.0), e OpenSSH 10 ha anche sshd-auth.
if $programname startswith "sshd" or $programname == ["sudo", "su", "login", "systemd-logind", "gdm-password"] then {
    call ads
}
