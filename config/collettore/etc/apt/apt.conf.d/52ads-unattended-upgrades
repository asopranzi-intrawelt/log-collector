// Aggiornamenti automatici: solo sicurezza, nessun riavvio automatico (handoff, sez. 2 punto 5).
// #clear azzera le origini dichiarate da 50unattended-upgrades, che precede questo file.
// [Non verificato] origini ed etichette su Debian 13: controllare con
// `unattended-upgrade --dry-run --debug` che vengano considerate solo le origini di sicurezza.
APT::Periodic::Update-Package-Lists "1";
APT::Periodic::Unattended-Upgrade "1";

#clear Unattended-Upgrade::Origins-Pattern;
Unattended-Upgrade::Origins-Pattern {
        "origin=Debian,codename=${distro_codename},label=Debian-Security";
        "origin=Debian,codename=${distro_codename}-security,label=Debian-Security";
};
Unattended-Upgrade::Automatic-Reboot "false";
