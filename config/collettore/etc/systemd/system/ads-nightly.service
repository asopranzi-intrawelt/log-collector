[Unit]
Description=Compressione e manifest dei giorni da chiudere del collettore AdS
RequiresMountsFor=/srv/ads
After=systemd-journald.service

[Service]
Type=oneshot
User=ads
Group=ads
UMask=0027
ExecStart=/usr/bin/bash /opt/ads/bin/ads-nightly.sh --require-log-mount
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/srv/ads
ReadWritePaths=/var/lib/ads
