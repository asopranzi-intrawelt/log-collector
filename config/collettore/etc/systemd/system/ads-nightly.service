[Unit]
Description=Compressione e manifest del giorno precedente del collettore AdS
After=systemd-journald.service

[Service]
Type=oneshot
User=ads
Group=ads
UMask=0027
ExecStart=/usr/bin/bash /opt/ads/bin/ads-nightly.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/srv/ads
ReadWritePaths=/var/lib/ads
