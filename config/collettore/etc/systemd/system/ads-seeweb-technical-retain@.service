[Unit]
Description=Scadenza degli eventi tecnici Seeweb dopo %i giorni
Documentation=file:/opt/ads/bin/ads-seeweb-technical-retain.sh

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/bin/bash /opt/ads/bin/ads-seeweb-technical-retain.sh --apply --days %i
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=-/var/log/ads-seeweb-technical
ProtectHome=true
PrivateTmp=true
