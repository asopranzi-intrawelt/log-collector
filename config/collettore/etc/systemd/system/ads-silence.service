[Unit]
Description=Controllo giornaliero del segnale delle sorgenti AdS
Documentation=file:/opt/ads/bin/ads-silence.py
RequiresMountsFor=/srv/ads
After=systemd-journald.service

[Service]
Type=oneshot
User=ads
Group=ads
UMask=0077
ExecStart=/usr/bin/python3 /opt/ads/bin/ads-silence.py --require-log-mount
NoNewPrivileges=true
PrivateTmp=true
PrivateNetwork=true
ProtectHome=true
ProtectSystem=strict
InaccessiblePaths=-/etc/ads/secrets
