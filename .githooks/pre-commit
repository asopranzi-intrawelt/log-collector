#!/bin/sh
# Pre-commit dei commit manuali. Esegue in ordine gli script di .githooks/pre-commit.d/, con cui
# i pacchetti aggiungono il proprio passo senza modificare questo file, che git ammette uno solo.
# Uno script che esce diverso da zero ferma il commit; uno che vuole soltanto avvisare esce zero.
# Non mette mai file in stage. Rispetto al pre-commit del template manca il passo readme-sync,
# perché questo progetto non ha adottato quel pacchetto.
set -eu

root=$(git rev-parse --show-toplevel)

python_cmd=""
for candidate in python3 python; do
    if command -v "$candidate" >/dev/null 2>&1 && "$candidate" -c 'import sys' >/dev/null 2>&1; then
        python_cmd="$candidate"
        break
    fi
done

# Gli script si eseguono con sh e non per bit di esecuzione, perché su Windows quel bit non
# viaggia con il clone e uno script ignorato in silenzio è il modo peggiore di fallire.
for passo in "$root"/.githooks/pre-commit.d/*; do
    [ -f "$passo" ] || continue
    case "$passo" in *.sample) continue ;; esac
    PYTHON_CMD="$python_cmd" sh "$passo" || exit 1
done
