local.file_match "technical_fixture" {
  path_targets = [{
    "__path__"     = "/var/log/pilot/technical-*.jsonl",
    "archive"      = "technical",
    "source_family" = "pilot",
    "service"      = "fixture",
  }]
}

loki.source.file "technical_fixture" {
  targets    = local.file_match.technical_fixture.targets
  forward_to = [loki.process.stable_labels.receiver]
}

loki.process "stable_labels" {
  stage.label_drop {
    values = ["filename"]
  }
  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
